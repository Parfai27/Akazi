ADMIN_PASSWORD=replace-me
SITE_URL=http://localhost:3000

# Optional. Without mail settings, alert signups are saved and emails stay queued.
# Gmail on this computer: host smtp.gmail.com, port 587, secure false, user is the
# Gmail address, pass is a Google app password (not the normal login password).
# The free live host blocks those mail ports. There, set MAIL_HOOK_URL and
# MAIL_HOOK_SECRET instead. They are not stored in git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=
MAIL_HOOK_URL=
MAIL_HOOK_SECRET=

# Optional. Google AdSense. Leave blank until Google gives you a publisher ID.
# ADSENSE_CLIENT looks like ca-pub-1234567890123456
# ADSENSE_SLOT is the display-ad unit number from the AdSense dashboard.
ADSENSE_CLIENT=
ADSENSE_SLOT=
