ADMIN_PASSWORD=replace-me
SITE_URL=http://localhost:3000

# Optional. Without these, alert signups are saved and emails stay queued.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=

# Optional. Google AdSense. Leave blank until Google gives you a publisher ID.
# ADSENSE_CLIENT looks like ca-pub-1234567890123456
# ADSENSE_SLOT is the display-ad unit number from the AdSense dashboard.
ADSENSE_CLIENT=
ADSENSE_SLOT=
